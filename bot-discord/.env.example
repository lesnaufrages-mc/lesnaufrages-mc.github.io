# Copie ce fichier en ".env" et remplis-le. Ne partage JAMAIS le fichier .env (il contient le token).

# Portail développeur Discord > ton appli > Bot > Reset Token
DISCORD_TOKEN=

# Clic droit sur le serveur > Copier l'identifiant du serveur (active le Mode développeur avant)
GUILD_ID=

# Salon où le bot dit bonjour aux nouveaux (clic droit sur le salon > Copier l'identifiant)
SALON_BIENVENUE_ID=

# Salon où le bot poste le rappel du mot du jour
SALON_MOT_DU_JOUR_ID=

# (facultatif) Rôle donné automatiquement à chaque nouveau membre
ROLE_ARRIVANT_ID=

# (facultatif) Rôle "🔔 Mot du jour" : les membres le prennent avec un bouton, le rappel les mentionne
ROLE_NOTIF_ID=

# Heure du rappel quotidien (heure de Paris, de 0 à 23)
RAPPEL_HEURE=9
