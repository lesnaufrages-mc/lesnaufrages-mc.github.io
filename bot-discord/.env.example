# Copie ce fichier en ".env" et remplis-le. Ne partage JAMAIS le fichier .env (il contient le token).

# Portail développeur Discord > ton appli > Bot > Reset Token
DISCORD_TOKEN=

# Clic droit sur le serveur > Copier l'identifiant du serveur (active le Mode développeur avant)
GUILD_ID=

# Salon où le bot dit bonjour aux nouveaux (clic droit sur le salon > Copier l'identifiant)
SALON_BIENVENUE_ID=

# Salon où le bot poste le rappel du mot du jour
SALON_MOT_DU_JOUR_ID=

# (facultatif) Salon où le bot poste les actualités du site (vérifiées toutes les 5 minutes)
SALON_ACTUS_ID=

# (facultatif) Salon où le bot affiche l'état du serveur Minecraft (par défaut : 1017711078752407622)
SALON_MINECRAFT_ID=
# (facultatif) Adresse et ports du serveur Minecraft (par défaut : naufragesmc.mine.fun, 30601, Bedrock 30603)
MC_ADRESSE=
MC_PORT=
MC_PORT_BEDROCK=

# (facultatif) Rôle donné automatiquement à chaque nouveau membre
ROLE_ARRIVANT_ID=

# (facultatif) Rôle "🔔 Mot du jour" : les membres le prennent avec un bouton, le rappel les mentionne
ROLE_NOTIF_ID=

# Heure du rappel quotidien (heure de Paris, de 0 à 23)
RAPPEL_HEURE=9

# Anti-pub (liens d'invitation vers d'autres serveurs Discord) : facultatif, valeurs par défaut déjà réglées.
# ANTIPUB_CATEGORIES=1573085261359751268,828255171045228554
# ANTIPUB_SALONS_OK=828255209113387058
# ANTIPUB_MOTS_SALONS_OK=faction
# ANTIPUB_SALON_LOGS_ID=
