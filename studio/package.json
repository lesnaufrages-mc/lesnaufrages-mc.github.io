{
  "name": "naufrages-studio",
  "productName": "Naufrages Studio",
  "version": "1.1.1",
  "description": "Naufragés Studio : logiciel de montage vidéo gratuit pour Windows, Mac et Linux.",
  "author": "Les Naufragés",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never",
    "build:mac": "electron-builder --mac zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.lesnaufrages.studio",
    "productName": "Naufrages Studio",
    "executableName": "NaufragesStudio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "NaufragesStudio-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Naufragés Studio",
      "artifactName": "NaufragesStudio-installation.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "NaufragesStudio-linux.${ext}",
      "synopsis": "Logiciel de montage vidéo"
    },
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "artifactName": "NaufragesStudio-mac.${ext}",
      "identity": null
    }
  },
  "repository": "https://github.com/lesnaufrages-mc/lesnaufrages-mc.github.io"
}
